{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*execute_sql",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/scripts/check-direct-ddl-execution.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/scripts/check-branch-pr-status.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/scripts/ai-check-suggest.sh",
            "timeout": 15,
            "statusMessage": "ai:check実行有無を確認中..."
          }
        ]
      }
    ]
  }
}
